{
  "name": "manitoba-opendata-parcelsearch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "legal:index": "Rscript ../r/build_legal_index.R",
    "assessment:index": "Rscript ../r/build_assessment_index.R",
    "manifest": "node scripts/build-manifest.js",
    "places": "node scripts/build-places.js",
    "flood:overlay": "node scripts/build-flood-overlay.js",
    "flood:shards": "Rscript ../r/build_flood.R",
    "data:all": "Rscript ../r/build_legal_index.R && Rscript ../r/build_assessment_index.R && Rscript ../r/build_section_grid.R && Rscript ../r/build_river_lots.R && Rscript ../r/build_masc_shards.R && Rscript ../r/build_parcel_masc.R && Rscript ../r/build_landcover.R && node scripts/build-manifest.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "eslint . && node test/run.js"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@turf/area": "^7.1.0",
    "@turf/bbox": "^7.1.0",
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "@turf/intersect": "^7.1.0",
    "@turf/length": "^7.3.5",
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^4.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.0",
    "vite": "^7.3.5"
  }
}
