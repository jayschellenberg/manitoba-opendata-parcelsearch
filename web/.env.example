# Copy this file to .env.local and fill in your Mapbox public token.
# .env.local is gitignored — never commit your real token.
#
# In Vercel, add VITE_MAPBOX_TOKEN under Project → Settings →
# Environment Variables, then redeploy.
#
# Get a token at https://account.mapbox.com/access-tokens/
# A public ("pk.") token is correct here. The route planner uses:
#   - Matrix API     (distance/time matrix between stops)
#   - Directions API (driving polyline for the planned route)
#   - Static Images  (numbered map for the print itinerary)
#
# All three are on the Mapbox free tier (100k requests/month at the
# time of writing). A typical day of route planning is well under
# the free-tier cap.

VITE_MAPBOX_TOKEN=pk.eyJ1...replace-me
