# Copy this file to .env.local and fill in your Mapbox public token.
# .env.local is gitignored — never commit your real token.
#
# In Vercel, add VITE_MAPBOX_TOKEN under Project → Settings →
# Environment Variables, then redeploy.
#
# Get a token at https://account.mapbox.com/access-tokens/
# A public ("pk.") token is correct here. The route planner uses:
#   - Matrix API     (distance/time matrix between stops)
#   - Directions API (driving polyline for the planned route)
#   - Static Images  (numbered map for the print itinerary)
#
# All three are on the Mapbox free tier (100k requests/month at the
# time of writing). A typical day of route planning is well under
# the free-tier cap.

VITE_MAPBOX_TOKEN=pk.eyJ1...replace-me

# Optional MLI historical aerial PMTiles archive. Leave blank until the local
# build documented in docs/MLI-IMAGERY-BASEMAP.md has been uploaded.
VITE_MLI_ORTHO_PMTILES_URL=

# Assessment Parcels vector-tile archive (MAINTENANCE.md 1e).
#
# Leave BLANK for local development: the default is /parcels.pmtiles, i.e. the
# archive sitting in web/public/, which works offline and costs no egress.
# That copy must never be committed -- it is ~363 MB and gitignored, and Vite
# copies web/public/ into dist/, so a stray copy would ship on every deploy.
#
# In Vercel set this to the published archive. It is public, and already
# allowed by the CSP connect-src in vercel.json (same bucket as the ortho
# above, so no CSP change was needed):
#   https://pub-091058079bf6458da1681945177e1682.r2.dev/mb-assessment-parcels.pmtiles
VITE_PARCEL_TILES_URL=
