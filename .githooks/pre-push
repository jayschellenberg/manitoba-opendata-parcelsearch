#!/bin/sh
# Pre-push gate — runs the web test suite before any push so a broken
# change is caught locally, not after it reaches Vercel.
#
# GitHub Actions is enabled (ci.yml runs the test suite on push/PR), and
# the Vercel build also runs `npm test` before `npm run build` — a
# failing test fails the deploy. This hook is the fast local complement
# to both.
#
# Enable once per clone (hooks aren't pushed):
#   git config core.hooksPath .githooks
#
# Bypass for an emergency push:  git push --no-verify

echo "pre-push: running web test suite..."
if ! ( cd "$(git rev-parse --show-toplevel)/web" && npm test ); then
  echo "pre-push: tests FAILED — push aborted (use --no-verify to override)."
  exit 1
fi
echo "pre-push: tests passed."
exit 0
