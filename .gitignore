# Node
node_modules/
web/node_modules/
web/dist/
.npm/

# Local env (never commit API keys / Vercel tokens)
.env
.env.local
.env.*.local

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Companion ETL pipeline — kept locally for reference, not part of this site
mao-assembly/

# Throwaway staging for the fresh provincial download in the publish pipeline
# (r/download_provincial_snapshot.R default output; the scheduled wrapper uses
# %LOCALAPPDATA% instead). Never commit these large source layers.
.staging/

# R archive output (data files; trivially regenerable, often huge)
*.gpkg
*.tif
*.parquet
ParcelCrossRef_*.csv

# Generated legal-search index — built by r/build_legal_index.R from
# the MAO scrape parquet. ~60 MB; trivially regenerable. Production
# build pulls it from the build output rather than tracking it here.
web/public/data/legal-index.json

# Generated assessment index — built by r/build_assessment_index.R
# from the MAO scrape's tax_history.parquet. ~17 MB / 3.5 MB gzipped.
# Powers the sales-CSV "Vacant land only" filter (and any future
# value-based affordances). Production fetches via the
# api/assessment-index Edge Function from a GitHub Release asset.
web/public/data/assessment-index.json

# Generated per-municipality MASC soil-rating shards built by
# r/build_masc_shards.R from masc_soil_ratings_with_latlon.csv.
# ~14 MB across ~99 shards; max single file ~448 KB. Tracked in
# source control so Vercel ships them as static assets — well
# under GitHub's 100 MB / file ceiling, no LFS needed. To refresh:
# rerun build_masc_shards.R, commit the changed shards.
# web/public/data/masc/

# Source CSV the MASC shards are built from. ~8 MB raw.
masc_soil_ratings_with_latlon.csv

# Datasets served via the mb-parcel-data CDN repo (jsDelivr pinned
# commit — see MB_PARCEL_DATA_CDN in web/src/arcgis.js). Local copies
# from before the move should not come back — `git status` would
# otherwise pick up a re-run that wrote into web/public/data/ by
# accident.
web/public/data/parcel-masc/
web/public/data/assessment/
web/public/data/masc/
web/public/data/landcover/
web/public/data/landcover-tiles/
web/public/data/river-lots.json
web/public/data/masc-riverlots.json

# Section grid now ships from a GitHub Release via api/section-grid.js
# (same pattern as the legal + assessment indexes — file is too large
# for jsDelivr's per-file cap and was the data diet's last holdout).
# To regenerate, run `Rscript r/build_section_grid.R` then publish a
# new release and bump RELEASE_URL in api/section-grid.js.
web/public/data/section-grid.json

# Editor / tooling temp files
*.tmp.*
*.timestamp-*.mjs
*.swp

