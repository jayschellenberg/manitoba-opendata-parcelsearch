# Companion ETL pipeline — kept locally for reference, not part of this site
mao-assembly/

# R archive output (data files; trivially regenerable, often huge)
*.gpkg
*.tif
*.parquet
ParcelCrossRef_*.csv

# Generated legal-search index — built by r/build_legal_index.R from
# the MAO scrape parquet. ~60 MB; trivially regenerable. Production
# build pulls it from the build output rather than tracking it here.
web/public/data/legal-index.json

# Generated per-municipality MASC soil-rating shards built by
# r/build_masc_shards.R from masc_soil_ratings_with_latlon.csv.
# ~14 MB across ~99 shards; max single file ~448 KB. Tracked in
# source control so Vercel ships them as static assets — well
# under GitHub's 100 MB / file ceiling, no LFS needed. To refresh:
# rerun build_masc_shards.R, commit the changed shards.
# web/public/data/masc/

# Source CSV the MASC shards are built from. ~8 MB raw.
masc_soil_ratings_with_latlon.csv

